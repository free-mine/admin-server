{
  "name": "ore-vein-admin-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:fork": "tsx scripts/fork-smoke.ts"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "fastify": "5.12.8",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@uniswap/v3-sdk": "3.31.8",
    "hardhat": "2.29.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
